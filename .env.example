# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME="AI Project Template"
APP_ENV="development"
DEBUG=true
API_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# ==============================================================================
# LLM Providers & API Keys
# ==============================================================================
# OpenAI
OPENAI_API_KEY=""

# Anthropic
ANTHROPIC_API_KEY=""

# Google GenAI / Gemini
GOOGLE_API_KEY=""

# Ollama / Local Models
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_MODEL="llama3"

# ==============================================================================
# Observability & Tracking
# ==============================================================================
# OpenTelemetry
OTEL_SERVICE_NAME="ai-agent-service"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# MLflow
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="agent-experiments"

# LangSmith (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="ai-agent-project"
